GITHUB_TOKEN=
DEMO_REPO=pallets/flask

# Model providers (OpenAI-compatible). Set one or more keys; LLM_PROVIDERS sets the fallback order.
GROQ_API_KEY=
NVIDIA_API_KEY=
# TOGETHER_API_KEY=
# GEMINI_API_KEY=                  # aistudio.google.com; proprietary model
# LLM_PROVIDERS=groq,nvidia        # default: every provider with a key, in order groq, gemini, nvidia, together
# GEMINI_MODEL=gemini-3-flash-preview
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_BASE_URL= / LLM_API_KEY= / LLM_MODEL=   # any other OpenAI-compatible endpoint ("custom")

# CHROMA_PERSIST_DIR=        # default: ~/.magewise/chroma
# MAGEWISE_TOKEN=            # required for magewise-mcp --http on a public interface
